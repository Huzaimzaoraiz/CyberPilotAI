# .env.example
# Copy this file to .env and populate with your credentials

# Database Configuration (PostgreSQL 15 via Docker or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberdefense

# LLM Configuration (Google Gemini OpenAI-compatible endpoint or native OpenAI)
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-latest,gpt-4o-mini

# Optional OpenAI fallback
OPENAI_API_KEY=

# Threat Intelligence & OSINT APIs
# VirusTotal API Key (Powers Threat Intelligence Agent and recon lookups)
VT_API_KEY=

# HaveIBeenPwned API Key (Optional; automated privacy-preserving simulation fallback active if empty)
HIBP_API_KEY=

# National Vulnerability Database API Key (Optional; automated simulation fallback active if empty)
NVD_API_KEY=
