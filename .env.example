# .env.example
# Copy this file to .env and populate with your own API keys

# LLM Configuration (Configured for Google Gemini OpenAI-compatible endpoint or native OpenAI)
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-2.5-pro,gpt-4o-mini

# Optional OpenAI fallback
OPENAI_API_KEY=

# Threat Intelligence & OSINT APIs
# VirusTotal API Key (Powers Threat Intelligence Agent lookups)
VT_API_KEY=

# HaveIBeenPwned API Key (Optional; automated simulation fallback active if empty)
HIBP_API_KEY=

# National Vulnerability Database API Key (Optional; automated simulation fallback active if empty)
NVD_API_KEY=
